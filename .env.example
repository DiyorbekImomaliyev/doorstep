# Copy to .env and fill in. Sandbox and test keys ONLY. Never commit .env.

# PayPal (sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# Shippo (test mode key)
SHIPPO_API_KEY=
SHIPPO_WEBHOOK_TOKEN=

# App AI model (runtime). Switch providers without code changes.
# Main: Claude (best quality for the demo). Fallback + bulk evals: Gemini free tier.
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
LLM_FALLBACK_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
EVAL_LLM_PROVIDER=gemini
LLM_TIMEOUT_S=20

# App
DATABASE_URL=postgresql://localhost:5432/doorstep
APP_BASE_URL=http://localhost:8000
SIGNING_SECRET=
RECEIPT_SIGNING_KEY=

# Langfuse (optional until build day 2)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=

# Frontend
AG_GRID_LICENSE_KEY=
AG_STUDIO_LICENSE_KEY=

# Tests (optional). Postgres tests default to DATABASE_URL's db name + "_test".
TEST_DATABASE_URL=
