# Copy to .env and fill in. Sandbox and test keys ONLY. Never commit .env.

# PayPal (sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# Shippo (test mode key)
SHIPPO_API_KEY=
SHIPPO_WEBHOOK_TOKEN=

# AI models. Every call goes through app/ai/llm.py; switch providers without code changes.
# Runtime: Claude Sonnet first, Gemini when Claude is down or past the daily cap.
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
LLM_FALLBACK_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
LLM_TIMEOUT_S=20
LLM_DAILY_CALL_LIMIT=400
# Evals: the Gemini free tier. Set the fallback to anthropic to let Claude answer while Gemini's
# quota is out, for at most EVAL_PAID_PROMPT_LIMIT prompts per run. Empty: replay or skip instead.
EVAL_LLM_PROVIDER=gemini
EVAL_LLM_FALLBACK_PROVIDER=
EVAL_PAID_PROMPT_LIMIT=100

# App
# Blank: a local SQLite file (doorstep.db). For Postgres: postgresql://localhost:5432/doorstep
DATABASE_URL=
APP_BASE_URL=http://localhost:8000
SIGNING_SECRET=
RECEIPT_SIGNING_KEY=

# Frontend
AG_GRID_LICENSE_KEY=
AG_STUDIO_LICENSE_KEY=

# Tests (optional). Postgres tests default to DATABASE_URL's db name + "_test".
TEST_DATABASE_URL=

# Process and tuning (optional; defaults shown)
APP_ENV=development            # Render sets production
EMBEDDED_WORKER=               # 1 runs the worker inside the web process (local dev)
STALE_TRACKING_HOURS=72        # hours without a carrier scan before a parcel counts as stale
ASK_MODEL_CALLS_PER_HOUR=60    # cap on Ask Doorstep model calls per seller per hour
STUDIO_AGENT_CALLS_PER_HOUR=120  # cap on the Insights (AG Studio) agent's model calls per hour
# Render sets RENDER and RENDER_EXTERNAL_URL itself; leave them unset locally.

# Scripts and test suites (optional, off by default)
SMOKE_CURRENCY=USD             # scripts/sandbox_smoke.py: currency of the sandbox order
SMOKE_DATABASE_URL=            # scripts/sandbox_smoke.py: a database other than a scratch SQLite file
RUN_SANDBOX_SMOKE=             # 1 runs the live PayPal sandbox smoke test
RUN_SANDBOX_CHECKS=            # 1 runs the live sandbox refund check
REQUIRE_PG=                    # 1 fails the Postgres tests instead of skipping when no database is set
RAGAS_JUDGE_MODEL=             # another Gemini model for the Ragas judge (blank: GEMINI_MODEL)
REDTEAM_DELAY_S=4              # seconds between red-team prompts (free-tier rate limit)
E2E_BASE_URL=http://127.0.0.1:8000  # Playwright target (web/e2e)
